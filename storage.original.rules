rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function active() { return request.auth != null &&
      (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) ||
       firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'active') == 'active'); }
    function admin() { return active() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function lessonParticipant(lessonId) {
      return active() && request.auth.uid in
        firestore.get(/databases/(default)/documents/lesson_requests/$(lessonId)).data.participantIds;
    }
    match /coach_documents/{uid}/{filename} {
      allow read: if active() && (request.auth.uid == uid || admin());
      allow create: if active() && request.auth.uid == uid
        && resource == null
        && filename.matches('[A-Za-z0-9_-]{1,100}\\.pdf')
        && request.resource.contentType == 'application/pdf'
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /videos/{uid}/{filename} {
      allow read: if active();
      allow create, update: if active() && request.auth.uid == uid
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.size > 0
        && request.resource.contentType.matches('video/.*');
      allow delete: if active() && request.auth.uid == uid;
    }
    match /lesson_feedback/{lessonId}/{uid}/{filename} {
      allow read: if lessonParticipant(lessonId) || admin();
      allow create: if lessonParticipant(lessonId)
        && request.auth.uid == uid
        && resource == null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.size > 0
        && request.resource.contentType.matches('video/.*');
      allow update: if false;
      allow delete: if active() && (request.auth.uid == uid || admin());
    }
  }
}
